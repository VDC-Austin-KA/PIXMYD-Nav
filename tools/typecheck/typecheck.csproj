<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Compiles every PIXMYD-Nav source file on any platform, with no
    Navisworks installation required.

    The Navisworks references come from the Speckle.Navisworks.API package.
    There is no MainWindow.xaml yet (the tool windows are deferred work -
    see docs/work-orders/pixmy4d-nav.md tasks P3/P4), so gen_xaml_stub.py is
    currently a no-op; once a window is added, re-add obj/MainWindow.g.cs to
    the <Compile Include> list below.

      python tools/typecheck/gen_xaml_stub.py
      dotnet build tools/typecheck/typecheck.csproj

    Pass NWPackageVersion to check a specific Navisworks year:

      dotnet build tools/typecheck/typecheck.csproj -p:NWPackageVersion=2025.0.0

    NWYear (used to define the NW<year> constant DefineConstants branches on)
    is derived automatically from the first 4 characters of NWPackageVersion.

    It does not produce a usable DLL; it exists to catch compile errors
    without a Windows/Navisworks machine.
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>PIXMYD_Nav</RootNamespace>
    <AssemblyName>PIXMYD-Nav.Typecheck</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NWPackageVersion Condition="'$(NWPackageVersion)' == ''">2027.0.0</NWPackageVersion>
    <NWYear>$(NWPackageVersion.Substring(0, 4))</NWYear>
    <DefineConstants>$(DefineConstants);NW$(NWYear)</DefineConstants>
    <!-- CS0649: the generated stub's control fields are never assigned. -->
    <NoWarn>$(NoWarn);CS0649;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../PIXMYD-Nav/**/*.cs" Exclude="../../PIXMYD-Nav/obj/**/*.cs;../../PIXMYD-Nav/bin/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Speckle.Navisworks.API" Version="$(NWPackageVersion)" PrivateAssets="all" ExcludeAssets="runtime" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>
</Project>
