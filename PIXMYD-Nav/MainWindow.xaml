<Window x:Class="PIXMYD_Nav.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PIXMYD-Nav — Points, Field Markers, AR Model Export"
        Height="720" Width="1040"
        MinHeight="560" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        Background="#FFF4F5F7"
        FontFamily="Segoe UI" FontSize="12">

    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#FF1F6FEB"/>
        <SolidColorBrush x:Key="Panel" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="Line" Color="#FFDDE1E6"/>
        <SolidColorBrush x:Key="Muted" Color="#FF6B7280"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Foreground" Value="#FF111827"/>
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,8"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="MinWidth" Value="76"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Padding" Value="18,6"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#FFB6C4DA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,3"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="Foreground" Value="#FF374151"/>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="#FF111827" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="PIXMYD-Nav" Foreground="White" FontSize="19" FontWeight="Bold"/>
                    <TextBlock x:Name="SubtitleText" Foreground="#FF9CA3AF" Margin="0,1,0,0"
                               Text="Points, field markers and AR model export — bridge to the PIXMYD phone app"/>
                </StackPanel>
                <TextBlock x:Name="DocumentText" Grid.Column="1" Foreground="#FF9CA3AF"
                           VerticalAlignment="Center" TextAlignment="Right"/>
            </Grid>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Text="Ready." Foreground="#FF374151"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Open output folder" Click="OnOpenOutputFolder" MinWidth="130"/>
                    <Button Content="Close" Click="OnClose"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="Tabs" Margin="12" Background="Transparent" BorderThickness="0">

            <!-- ── Points ─────────────────────────────────────────────── -->
            <TabItem Header="  Points  ">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="8">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionHeader}"
                                       Text="Survey points"/>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}"
                                       Text="Captured from the current selection — one point per selected item, positioned at its bounding-box centre. Positions are in target units relative to the applied offset; grid fields are filled by you (Navisworks exposes no grid data to plugins)."/>

                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="Capture selection" Click="OnCaptureSelection"
                                        Style="{StaticResource PrimaryButton}"/>
                                <Button Content="Capture whole model" Click="OnCaptureModel"/>
                                <Button Content="Clear" Click="OnClearPoints"/>
                                <Button Content="Remove selected" Click="OnRemoveSelected"/>
                            </StackPanel>

                            <ListBox x:Name="PointList" BorderBrush="{StaticResource Line}"
                                     HorizontalContentAlignment="Stretch" FontSize="11"
                                     SelectionMode="Extended">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="54"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Id}" FontFamily="Consolas"
                                                       VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="1" Text="{Binding Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     VerticalContentAlignment="Center" BorderThickness="0"
                                                     Background="Transparent"
                                                     ToolTip="Point label — shown on the marker page"/>
                                            <TextBlock Grid.Column="2" Text="{Binding PositionText}"
                                                       FontFamily="Consolas" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBox Grid.Column="3" Text="{Binding Intersection, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     VerticalContentAlignment="Center" Padding="2,1"
                                                     ToolTip="Grid intersection, e.g. A-1 (optional)"/>
                                            <TextBox Grid.Column="4" Text="{Binding Level, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     VerticalContentAlignment="Center" Padding="2,1"
                                                     ToolTip="Level, e.g. L03 (optional)"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionHeader}" Text="Point set"/>

                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Set name"/>
                                    <TextBox x:Name="SetNameBox" Margin="0,0,0,8"/>

                                    <CheckBox x:Name="CapturePhotoCheck" IsChecked="True"
                                              Content="Capture the current view as each point's photo"/>
                                    <CheckBox x:Name="MonoPhotoCheck" IsChecked="True"
                                              Content="Also write the small grayscale thumbnail"/>

                                    <Button Content="Export points.json" Click="OnExportPoints"
                                            Style="{StaticResource PrimaryButton}" Margin="0,10,0,0"
                                            HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ── Field markers ──────────────────────────────────────── -->
            <TabItem Header="  Field Markers  ">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Marker pages"/>

                                <TextBlock Style="{StaticResource Hint}"
                                           Text="One printable A4 page per point: inline SVG QR code (scans straight to the point in the phone app), id, label, coordinates and grid reference. Self-contained HTML — open it in a browser and print."/>

                                <TextBlock Style="{StaticResource FieldLabel}" Text="Output folder"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="MarkerFolderBox" VerticalContentAlignment="Center"/>
                                    <Button Grid.Column="1" Content="Browse…" Margin="6,0,0,0"
                                            MinWidth="72" Click="OnBrowseMarkerFolder"/>
                                </Grid>

                                <Button Content="Export markers.html" Click="OnExportMarkers"
                                        Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="MarkerStatusText" Style="{StaticResource Hint}"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionHeader}"
                                       Text="Everything written to the folder"/>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}"
                                       Text="markers.html — one page per point, browser-printed. points.json — the same data the Points tab exports, so the folder is a self-contained hand-off to the field. *_photo.png / *_photo_mono.png — the viewport capture for each point (taken at export time)."/> 
                            <ItemsControl x:Name="MarkerPlanList" FontFamily="Consolas" FontSize="11"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ── AR Model Export ────────────────────────────────────── -->
            <TabItem Header="  AR Model  ">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="AR model"/>

                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Writes the whole-model bounding box and the current camera as ar-model.json, so the phone app can anchor the model on top of the real world. The box is shifted so its minimum corner sits at the origin; the shift is recorded and reversible."/>

                                <TextBlock Style="{StaticResource FieldLabel}" Text="Output folder"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ArFolderBox" VerticalContentAlignment="Center"/>
                                    <Button Grid.Column="1" Content="Browse…" Margin="6,0,0,0"
                                            MinWidth="72" Click="OnBrowseArFolder"/>
                                </Grid>

                                <CheckBox x:Name="ArCaptureCheck" IsChecked="True"
                                          Content="Capture the current view as the anchor photo"/>
                                <CheckBox x:Name="ArMonoCheck" IsChecked="True"
                                          Content="Also write the small grayscale thumbnail"/>

                                <Button Content="Export ar-model.json" Click="OnExportAr"
                                        Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                                        Margin="0,10,0,0"/>
                                <TextBlock x:Name="ArStatusText" Style="{StaticResource Hint}"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionHeader}"
                                       Text="What gets written"/>
                            <TextBlock x:Name="ArPreviewText" FontFamily="Consolas" FontSize="11"
                                       TextWrapping="Wrap"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>