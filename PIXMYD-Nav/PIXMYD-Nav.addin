<?xml version="1.0" encoding="utf-8"?>
<!--
  Navisworks add-in manifest.

  Deployed alongside PIXMYD-Nav.dll into:
      C:\Program Files\Autodesk\Navisworks Manage <year>\Plugins\PIXMYD-Nav\

  The plugin appears on the Add-Ins ribbon tab as "PIXMYD-Nav".
-->
<PluginsFile xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Plugins>
    <Plugin Name="PIXMYD-Nav" Assembly="PIXMYD-Nav.dll" DeveloperId="ACLP_VDC" DisplayName="PIXMYD-Nav">
      <Description>Points, Field Marker Export and AR Model Export — bridge to the PIXMYD phone app</Description>
    </Plugin>
  </Plugins>
</PluginsFile>
