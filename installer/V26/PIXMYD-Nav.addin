<?xml version="1.0" encoding="utf-8"?>
<!--
  Navisworks add-in manifest.

  Deployed alongside PIXMYD-Nav.dll into:
      C:\Program Files\Autodesk\Navisworks Manage <year>\Plugins\PIXMYD-Nav\

  The plugin appears on the Add-Ins ribbon tab as "PIXMYD-Nav".
-->
<Addin Version="1.0">
  <CompanyName>ACLP_VDC</CompanyName>
  <AddInName>PIXMYD-Nav</AddInName>
  <AddInDescription>Points, Field Marker Export and AR Model Export - bridge to the PIXMYD phone app</AddInDescription>
  <AddInVersion>1.0.0.0</AddInVersion>
  <FullClassName>PIXMYD_Nav.PluginMain</FullClassName>
  <AssemblyFile>PIXMYD-Nav.dll</AssemblyFile>
</Addin>